<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Scopework" Manufacturer="Scopework" Version="$(Version)"
           UpgradeCode="ABEF253A-84C6-449A-BAB8-EBD64BC612B4" Scope="perUser" InstallerVersion="500">
    <MajorUpgrade DowngradeErrorMessage="A newer Scopework is already installed." />
    <MediaTemplate EmbedCab="yes" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Icon Id="ScopeworkIcon" SourceFile="$(SourceDir)\assets\scopework.ico" />
    <Property Id="ARPPRODUCTICON" Value="ScopeworkIcon" />
    <Property Id="OLDINSTALLDIR">
      <RegistrySearch Id="FindInstall" Root="HKCU" Key="Software\ResearchDashboard" Name="InstallDir" Type="raw" />
    </Property>
    <Property Id="SAVEDHOME">
      <RegistrySearch Id="FindHome" Root="HKCU" Key="Software\ResearchDashboard" Name="ResearchHome" Type="raw" />
    </Property>
    <Property Id="SETTINGS_EXIST">
      <RegistrySearch Id="FindOptions" Root="HKCU" Key="Software\ResearchDashboard" Name="SettingsVersion" Type="raw" />
    </Property>
    <Property Id="SAVEDPATH">
      <RegistrySearch Id="FindPathOption" Root="HKCU" Key="Software\ResearchDashboard" Name="AddToPath" Type="raw" />
    </Property>
    <Property Id="ADDTOPATH" Secure="yes" />
    <Property Id="SAVEDDESKTOP">
      <RegistrySearch Id="FindDesktopOption" Root="HKCU" Key="Software\ResearchDashboard" Name="CreateDesktop" Type="raw" />
    </Property>
    <Property Id="DESKTOPSETTINGSEXIST">
      <RegistrySearch Id="FindDesktopSetting" Root="HKCU" Key="Software\ResearchDashboard" Name="DesktopPreferenceSet" Type="raw" />
    </Property>
    <Property Id="CREATEDESKTOP" Secure="yes" />
    <Property Id="SCOPEOPTIONSINITIALIZED" Secure="yes" />
    <Property Id="INSTALLFOLDER" Secure="yes" />
    <Property Id="RESEARCHHOME" Secure="yes" />
    <SetProperty Id="INSTALLFOLDER" Value="[OLDINSTALLDIR]" After="AppSearch" Condition="OLDINSTALLDIR AND NOT INSTALLFOLDER" />
    <SetProperty Id="RESEARCHHOME" Value="[SAVEDHOME]" After="AppSearch" Condition="SAVEDHOME AND NOT RESEARCHHOME" />
    <SetProperty Id="RESEARCHHOME" Action="UseLegacyHome" Value="[LocalAppDataFolder]ResearchDashboard" After="SetRESEARCHHOME" Condition="OLDINSTALLDIR AND NOT SAVEDHOME AND NOT RESEARCHHOME" />
    <SetProperty Id="ADDTOPATH" Value="[SAVEDPATH]" After="AppSearch" Condition="NOT SCOPEOPTIONSINITIALIZED AND SETTINGS_EXIST AND NOT ADDTOPATH" />
    <SetProperty Id="ADDTOPATH" Action="DefaultPathChoice" Value="1" After="SetADDTOPATH" Condition="NOT SCOPEOPTIONSINITIALIZED AND NOT SETTINGS_EXIST AND NOT ADDTOPATH" />
    <SetProperty Id="CREATEDESKTOP" Value="[SAVEDDESKTOP]" After="DefaultPathChoice" Condition="NOT SCOPEOPTIONSINITIALIZED AND DESKTOPSETTINGSEXIST AND NOT CREATEDESKTOP" />
    <SetProperty Id="CREATEDESKTOP" Action="DefaultDesktopChoice" Value="1" After="SetCREATEDESKTOP" Condition="NOT SCOPEOPTIONSINITIALIZED AND NOT DESKTOPSETTINGSEXIST AND NOT CREATEDESKTOP" />
    <SetProperty Id="SCOPEOPTIONSINITIALIZED" Value="1" After="DefaultDesktopChoice" />
    <UIRef Id="ScopeworkUI" />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Scopework">
          <Component Id="DesktopApp" Guid="823CFF3B-D10B-4945-9B9A-3C3E8B4725D8">
            <File Id="DashboardExe" Source="$(BuildDir)\research-dashboard.exe" />
            <RegistryValue Root="HKCU" Key="Software\ResearchDashboard" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" KeyPath="yes" />
          </Component>
          <Component Id="ConsoleApp" Guid="633A1A70-C073-4FC7-A407-AF96966204F4">
            <File Id="ResearchExe" Source="$(BuildDir)\research.exe" />
            <RegistryValue Root="HKCU" Key="Software\ResearchDashboard" Name="CLI" Value="1" Type="integer" KeyPath="yes" />
          </Component>
          <Component Id="OptionalPath" Guid="795DADE1-C191-4A5B-AF88-332899B96538" Condition="ADDTOPATH = &quot;1&quot;" Transitive="yes">
            <Environment Id="UserPath" Name="PATH" Value="[INSTALLFOLDER]" Permanent="no" Part="last" Action="set" System="no" />
            <RegistryValue Root="HKCU" Key="Software\ResearchDashboard" Name="PathComponent" Value="1" Type="integer" KeyPath="yes" />
          </Component>
          <Component Id="UserGuide" Guid="E4EFB6A4-CE73-4723-8D5B-225DBB6B9677">
            <File Source="$(SourceDir)\README.md" />
            <File Source="$(SourceDir)\AGENTS.md" />
            <File Source="$(SourceDir)\LICENSE" />
            <File Source="$(SourceDir)\CONTRIBUTING.md" />
            <File Source="$(SourceDir)\CHANGELOG.md" />
            <RegistryValue Root="HKCU" Key="Software\ResearchDashboard" Name="Guide" Value="1" Type="integer" KeyPath="yes" />
          </Component>
          <Directory Id="DocsFolder" Name="docs">
            <Component Id="CliGuide" Guid="28D781C9-A270-4EE6-A861-F9D16C963B96">
              <File Source="$(SourceDir)\docs\cli.md" />
              <File Source="$(SourceDir)\docs\research-model.md" />
              <File Source="$(SourceDir)\docs\installation.md" />
              <File Source="$(SourceDir)\docs\building.md" />
              <File Source="$(SourceDir)\docs\concurrent-import-design.md" />
              <File Source="$(SourceDir)\docs\qualification-0.5.0.md" />
              <RegistryValue Root="HKCU" Key="Software\ResearchDashboard" Name="CliGuide" Value="1" Type="integer" KeyPath="yes" />
              <RemoveFolder Id="RemoveDocsFolder" On="uninstall" />
            </Component>
          </Directory>
          <Directory Id="AssetsFolder" Name="assets">
            <Component Id="ReadmeIcon" Guid="B221BD8D-B32B-4CF6-9EBA-4556738D8E63">
              <File Source="$(SourceDir)\assets\scopework.png" />
              <RegistryValue Root="HKCU" Key="Software\ResearchDashboard" Name="ReadmeIcon" Value="1" Type="integer" KeyPath="yes" />
              <RemoveFolder Id="RemoveAssetsFolder" On="uninstall" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="RESEARCHHOME" Name="Scopework">
        <Component Id="ResearchHomeSettings" Guid="796FA3D3-FB24-434D-9E4F-D45A7A405392" Permanent="yes">
          <CreateFolder />
          <RegistryValue Root="HKCU" Key="Software\ResearchDashboard" Name="ResearchHome" Value="[RESEARCHHOME]" Type="string" KeyPath="yes" />
          <RegistryValue Root="HKCU" Key="Software\ResearchDashboard" Name="AddToPath" Value="[ADDTOPATH]" Type="string" />
          <RegistryValue Root="HKCU" Key="Software\ResearchDashboard" Name="SettingsVersion" Value="1" Type="string" />
          <RegistryValue Root="HKCU" Key="Software\ResearchDashboard" Name="CreateDesktop" Value="[CREATEDESKTOP]" Type="string" />
          <RegistryValue Root="HKCU" Key="Software\ResearchDashboard" Name="DesktopPreferenceSet" Value="1" Type="string" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="MenuFolder" Name="Scopework">
        <Component Id="StartMenu" Guid="4C1A845C-891B-41DE-B5E9-CDBB4D2B58C1">
          <Shortcut Id="DashboardShortcut" Name="Scopework" Target="[#DashboardExe]" WorkingDirectory="INSTALLFOLDER" Icon="ScopeworkIcon" IconIndex="0" />
          <RemoveFolder Id="RemoveMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\ResearchDashboard" Name="Shortcut" Value="1" Type="integer" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="5581AE80-4A5A-490B-8D65-1F4CA41F87A0" Condition="CREATEDESKTOP = &quot;1&quot;" Transitive="yes">
        <Shortcut Id="DesktopShortcut" Name="Scopework" Target="[#DashboardExe]" WorkingDirectory="INSTALLFOLDER" Icon="ScopeworkIcon" IconIndex="0" />
        <RegistryValue Root="HKCU" Key="Software\ResearchDashboard" Name="DesktopShortcut" Value="1" Type="integer" KeyPath="yes" />
      </Component>
    </StandardDirectory>
    <Feature Id="Main" Title="Scopework" Level="1">
      <ComponentRef Id="DesktopApp" />
      <ComponentRef Id="ConsoleApp" />
      <ComponentRef Id="OptionalPath" />
      <ComponentRef Id="ResearchHomeSettings" />
      <ComponentRef Id="UserGuide" />
      <ComponentRef Id="CliGuide" />
      <ComponentRef Id="ReadmeIcon" />
      <ComponentRef Id="StartMenu" />
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>
  </Package>
</Wix>
